{
  "version": 2,
  "routes": [
    {
      "src": "/api/test",
      "dest": "/api/minimal.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/v2(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/((?!api/|_next/|static/).*)",
      "dest": "/index.html"
    }
  ],
  "crons": []
}

{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/app.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/app.py"
    },
    {
      "src": "/v2(.*)",
      "dest": "/api/app.py"
    },
    {
      "src": "/((?!api/|_next/|static/).*)",
      "dest": "/frontend/build/index.html"
    }
  ],
  "crons": []
}

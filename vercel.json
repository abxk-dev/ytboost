{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/v2(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/((?!api/|v2/|_next/|static/).*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/run_all",
      "schedule": "0 0 * * *"
    }
  ]
}

# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net
DB_NAME=ytboost

# JWT Secrets (generate random strings for production)
JWT_SECRET=your_user_jwt_secret_here
JWT_REFRESH_SECRET=your_user_refresh_secret_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# Cron Job Secret (for Vercel cron authentication)
CRON_SECRET=your_cron_secret_here

# BSC Blockchain Configuration
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Payment Session Configuration
PAYMENT_SESSION_TTL_MINUTES=120
PAYMENT_SESSION_GRACE_MINUTES=360

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGIN_REGEX=https?://.+

# Optional: BscScan API Key for transaction verification
BSCSCAN_API_KEY=

# Optional: Debug mode
VITE_DEBUG_API=false
